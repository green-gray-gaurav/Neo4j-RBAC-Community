# Populate the real, root-owned /etc/neo4j-rbac/service.env. Never commit it.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_BEFORE_STARTING
RBAC_PERMISSIONS_FILE=/etc/neo4j-rbac/permissions.json
RBAC_JWT_KEY_FILE=/etc/neo4j-rbac/jwt.key
RBAC_MAX_ROWS=1000
RBAC_MAX_RESULT_BYTES=4194304
